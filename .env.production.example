# ALTER production environment
# Copy to /root/alter/.env and replace every CHANGE_ME value.
# Never commit the real file.

BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
APP_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
APP_EMAIL_MODE=smtp

DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_NAME=alter_project_db
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_DATABASE_PASSWORD@db:5432/alter_project_db
REDIS_URL=redis://redis:6379/0

OWNER_TELEGRAM_IDS=CHANGE_ME_TELEGRAM_ID
OWNER_EMAILS=CHANGE_ME_OWNER_EMAIL
SUPPORT_USERNAME=CHANGE_ME_SUPPORT_USERNAME
SUPPORT_TELEGRAM_ID=CHANGE_ME_SUPPORT_TELEGRAM_ID
TELEGRAM_BOT_USERNAME=alter_ai_bot
LEGAL_BASE_URL=https://alterai.ru

# Plans
SUBSCRIPTION_PRICE_RUB=990.00
EGO_PRICE_RUB=2990.00
SUBSCRIPTION_DAYS=30
PERSONAL_MONTHLY_CREDITS=1000
EGO_MONTHLY_CREDITS=5000
YUKASSA_SHOP_ID=CHANGE_ME
YUKASSA_SECRET_KEY=CHANGE_ME
YUKASSA_RECEIPT_EMAIL=CHANGE_ME
YUKASSA_SAVE_PAYMENT_METHOD=false

# AI safety and limits
OPENROUTER_ALLOW_PAID_FALLBACK=false
DAILY_REQUEST_LIMIT=100
MONTHLY_CREDITS=1000
SPAM_REQUEST_LIMIT=5
SPAM_WINDOW_SECONDS=60
HTTP_RATE_LIMIT=120
MAX_DISK_USED_PERCENT=85
BACKUP_MAX_AGE_HOURS=30
# Optional generic alert webhook (never print this value in logs)
ALERT_WEBHOOK_URL=
TELEGRAM_ALERT_CHAT_ID=
HTTP_RATE_WINDOW_SECONDS=60
AI_TIMEOUT_SECONDS=20
MEDIA_GENERATION_TIMEOUT_SECONDS=180
MEDIA_MAX_BYTES=20971520
MAX_OUTPUT_TOKENS=600
MAX_MEMORY_OUTPUT_TOKENS=250
MAX_MEDIA_OUTPUT_TOKENS=300
TOOL_MAX_ROUNDS=2

# OpenRouter models
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FREE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_MODEL_2=inclusionai/ling-3.0-flash:free
OPENROUTER_FREE_MODEL_3=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL_4=google/gemma-4-26b-a4b-it:free
OPENROUTER_FREE_MODEL_5=openai/gpt-oss-20b:free
OPENROUTER_FREE_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_VISION_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_REASONING_MODEL=inclusionai/ling-2.6-1t
OPENROUTER_FALLBACK_MODEL=inclusionai/ling-2.6-flash
OPENROUTER_FALLBACK_MODEL_2=openai/gpt-5.6-terra
TRANSCRIPTION_MODEL=openai/whisper-1
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=alloy
TTS_MAX_CHARS=1200
TTS_MAX_TOKENS=1024

# fal.ai media generation
MEDIA_PROVIDER=fal
MEDIA_GENERATION_API_KEY=CHANGE_ME_FAL_KEY
FAL_BASE_URL=https://fal.run
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext/max
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/master/image-to-video

# Search and YouTube
TAVILY_API_KEY=CHANGE_ME
YOUTUBE_API_KEY=CHANGE_ME

# SMTP
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME
SMTP_USE_TLS=true

# Runtime
PAYMENT_WEBHOOK_HOST=0.0.0.0
PAYMENT_WEBHOOK_PORT=8080
PAYMENT_WEBHOOK_PATH=/webhooks/yookassa
REDIS_CACHE_TTL=3600
SESSION_TIMEOUT=1800
MEMORY_RECALL_LIMIT=3
MEMORY_RECALL_MAX_DISTANCE=0.35
MEMORY_AUTO_RECALL_MIN_CHARS=8
MEMORY_PROMPT_MAX_CHARS=4500
MEMORY_SUMMARY_MAX_CHARS=7000
SUBSCRIPTION_RENEWAL_CHECK_SECONDS=3600

# Optional external OpenAI-compatible media provider; leave empty when using fal.
MEDIA_GENERATION_API_URL=
MEDIA_IMAGE_MODEL=
MEDIA_VIDEO_API_URL=
MEDIA_VIDEO_MODEL=
