# Required secrets
BOT_TOKEN=replace-with-telegram-bot-token
GEMINI_API_KEY=replace-with-gemini-key
APP_AUTH_SECRET=replace-with-long-random-auth-secret

# AI routing
OPENROUTER_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_ENABLED=false
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL_2=openai/gpt-oss-20b:free
OPENROUTER_FREE_MODEL_3=google/gemma-4-31b-it:free
OPENROUTER_FREE_MODEL_4=inclusionai/ling-3.0-tiny:free
OPENROUTER_FREE_MODEL_5=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_FREE_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_VISION_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_REASONING_MODEL=inclusionai/ling-2.6-1t
OPENROUTER_FALLBACK_MODEL=inclusionai/ling-2.6-flash
OPENROUTER_FALLBACK_MODEL_2=openai/gpt-oss-120b
OPENROUTER_ALLOW_PAID_FALLBACK=true
OPENROUTER_EXCLUDE_REASONING=true
AI_TIMEOUT_SECONDS=15
AI_STREAM_MODEL_TIMEOUT_SECONDS=10
AI_STREAM_MAX_MODELS=2
AI_MODEL_COOLDOWN_SECONDS=60
AI_DEEP_REVIEW_ENABLED=false
AI_DEEP_REVIEW_MAX_TOKENS=900
AI_MAX_PROMPT_CHARS=8000
TOOL_MAX_ROUNDS=2
MAX_OUTPUT_TOKENS=600
MAX_MEDIA_OUTPUT_TOKENS=300
MEDIA_MAX_BYTES=20971520
MEDIA_GENERATION_CREDITS=40
FAL_TEXT_IMAGE_CREDITS=100
FAL_TEXT_VIDEO_CREDITS=250
MEDIA_GENERATION_API_URL=
MEDIA_GENERATION_API_KEY=
# Use fal.ai for the configured image/video models below.
MEDIA_PROVIDER=fal
MEDIA_IMAGE_MODEL=
MEDIA_VIDEO_API_URL=
MEDIA_VIDEO_MODEL=
MEDIA_GENERATION_TIMEOUT_SECONDS=180
FAL_BASE_URL=https://fal.run
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=
FAL_TEXT_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra
FAL_TEXT_VIDEO_MODEL=fal-ai/kling-video/v2.1/master/text-to-video
MAX_MEMORY_OUTPUT_TOKENS=250

# Database and runtime
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/alter_project_db
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
SESSION_TIMEOUT=1800

# Independent application email verification
APP_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

