# Required secrets
BOT_TOKEN=replace-with-telegram-bot-token
GEMINI_API_KEY=replace-with-gemini-key
APP_AUTH_SECRET=replace-with-long-random-auth-secret

# AI routing
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FREE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_MODEL_2=inclusionai/ling-3.0-flash:free
OPENROUTER_FREE_MODEL_3=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL_4=google/gemma-4-26b-a4b-it:free
OPENROUTER_FREE_MODEL_5=openai/gpt-oss-20b:free
OPENROUTER_FREE_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_VISION_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_REASONING_MODEL=inclusionai/ling-2.6-1t
OPENROUTER_FALLBACK_MODEL=inclusionai/ling-2.6-flash
OPENROUTER_FALLBACK_MODEL_2=openai/gpt-5.6-terra
OPENROUTER_ALLOW_PAID_FALLBACK=false
AI_TIMEOUT_SECONDS=20
AI_MODEL_COOLDOWN_SECONDS=60
AI_DEEP_REVIEW_ENABLED=true
AI_DEEP_REVIEW_MAX_TOKENS=900
AI_MAX_PROMPT_CHARS=12000
TOOL_MAX_ROUNDS=2
MAX_OUTPUT_TOKENS=600
MAX_MEDIA_OUTPUT_TOKENS=300
MEDIA_MAX_BYTES=20971520
MAX_MEMORY_OUTPUT_TOKENS=250

# Database and runtime
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/alter_project_db
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
SESSION_TIMEOUT=1800

# Independent application email verification
APP_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Telegram linking and ownership
TELEGRAM_BOT_USERNAME=alter_ai_bot
OWNER_TELEGRAM_IDS=1271717628
OWNER_EMAILS=
SUPPORT_USERNAME=Adam_Omarov
SUPPORT_TELEGRAM_ID=1271717628
LEGAL_BASE_URL=https://alterai.ru

# Billing / YooKassa
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_RECEIPT_EMAIL=
SUBSCRIPTION_PRICE_RUB=490.00
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_RENEWAL_CHECK_SECONDS=3600
PAYMENT_WEBHOOK_HOST=0.0.0.0
PAYMENT_WEBHOOK_PORT=8080
PAYMENT_WEBHOOK_PATH=/webhooks/yookassa

# Limits and memory
DAILY_REQUEST_LIMIT=100
SPAM_REQUEST_LIMIT=5
SPAM_WINDOW_SECONDS=60
MEMORY_RECALL_LIMIT=3
MEMORY_RECALL_MAX_DISTANCE=0.35
MEMORY_AUTO_RECALL_MIN_CHARS=40
MEMORY_PROMPT_MAX_CHARS=4500
MEMORY_SUMMARY_MAX_CHARS=7000

# Optional tools and media
TAVILY_API_KEY=
YOUTUBE_API_KEY=
TRANSCRIPTION_MODEL=openai/whisper-1
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=alloy
TTS_MAX_CHARS=1200
TTS_MAX_TOKENS=1024
VOICE_REPLY_DEFAULT=true
